# Copier ce fichier en .env et remplir les valeurs

# Serveur
PORT=5001
FRONTEND_URL=http://localhost:3001

# Email — en local : SMTP Gmail (mot de passe d'application)
# En ligne (Render gratuit bloque le SMTP) : définir BREVO_API_KEY et EMAIL_FROM
# BREVO_API_KEY=
# EMAIL_FROM=adresse_validée_dans_brevo@gmail.com
# ADMIN_EMAIL=adresse_qui_reçoit_les_nouvelles_réservations (défaut : EMAIL_USER)
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=mot_de_passe_application_gmail

# Accès administrateur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=un_mot_de_passe_long_et_unique
# Clé de signature des jetons : générer avec `openssl rand -hex 32`
ADMIN_TOKEN_SECRET=

# MongoDB Atlas : Cluster0 > Connect > Drivers > copier l'URL (remplacer <db_password>)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sankofart

# Recherche intelligente (Atlas > AI Model APIs > Create model API key) — optionnel
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-lite
# VOYAGE_API_URL=https://ai.mongodb.com/v1

# Paiement de l'acompte PI-SPI (portail developer.pispi.bceao.int > Tableau de bord)
# PAIEMENT_MODE=pispi            # pispi | simulation (démos) | desactive ; défaut : pispi si configuré
# ACOMPTE_POURCENTAGE=30
PISPI_BASE_URL=                  # ex. https://no-mtls.piz.simulateurs.pi-bceao.com (sandbox)
PISPI_TOKEN_URL=                 # Credentials > URL du serveur d'autorisation
PISPI_PARTICIPANT_CODE=          # ex. CIC999 (préfixe des routes)
PISPI_CLIENT_ID=
PISPI_CLIENT_SECRET=
PISPI_API_KEY=
PISPI_SCOPES=piz/demande_paiement.write piz/demande_paiement.read piz/paiement.read
PISPI_PAYEE_ALIAS=               # Alias des comptes > adresse de paiement (SHID) du compte qui encaisse
PISPI_WEBHOOK_SECRET=            # affiché une seule fois à la création du webhook
