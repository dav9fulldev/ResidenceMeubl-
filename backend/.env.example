# Copier ce fichier en .env et remplir les valeurs

# Serveur
PORT=5001
FRONTEND_URL=http://localhost:3001

# Email (Gmail + mot de passe d'application)
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=mot_de_passe_application_gmail

# Accès administrateur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=un_mot_de_passe_long_et_unique
# Clé de signature des jetons : générer avec `openssl rand -hex 32`
ADMIN_TOKEN_SECRET=

# MongoDB Atlas : Cluster0 > Connect > Drivers > copier l'URL (remplacer <db_password>)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sankofart
