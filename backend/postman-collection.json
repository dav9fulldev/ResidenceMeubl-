              "raw": "{{base_url}}/api/residences/quartiers/Abidjan",
              "host": ["{{base_url}}"],
              "path": ["api", "residences", "quartiers", "Abidjan"]
            }
          }
        },
        {
          "name": "Vérifier disponibilité",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"residenceId\": 1,\n  \"dateArrivee\": \"2024-02-01\",\n  \"dateDepart\": \"2024-02-05\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/residences/check-disponibilite",
              "host": ["{{base_url}}"],
              "path": ["api", "residences", "check-disponibilite"]
            }
          }
        }
      ]
    },
    {
      "name": "📅 Réservations",
      "item": [
        {
          "name": "Créer une réservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"residenceId\": 1,\n  \"nom\": \"Dupont\",\n  \"prenom\": \"Jean\",\n  \"email\": \"jean.dupont@email.com\",\n  \"telephone\": \"+225070123456\",\n  \"dateArrivee\": \"2024-02-01\",\n  \"dateDepart\": \"2024-02-05\",\n  \"nombrePersonnes\": 2,\n  \"notes\": \"Arrivée en soirée\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/reservations",
              "host": ["{{base_url}}"],
              "path": ["api", "reservations"]
            }
          }
        },
        {
          "name": "Obtenir une réservation",
          "request": {
            "method": "GET",
            "header": [],
