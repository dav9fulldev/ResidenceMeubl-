{
  "info": {
    "name": "Sankofart Résidence API",
    "description": "Collection Postman pour tester l'API de réservation de Sankofart Résidence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🏥 Santé",
      "item": [
        {
          "name": "Vérifier la santé de l'API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "🏠 Résidences",
      "item": [
        {
          "name": "Liste des résidences",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/residences",
              "host": ["{{base_url}}"],
              "path": ["api", "residences"]
            }
          }
        },
        {
          "name": "Détails d'une résidence",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/residences/1",
              "host": ["{{base_url}}"],
              "path": ["api", "residences", "1"]
            }
          }
        },
        {
          "name": "Rechercher des résidences",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recherche\": \"Cocody\",\n  \"prixMin\": 30000,\n  \"prixMax\": 50000,\n  \"nombreChambres\": 2,\n  \"typeAppartement\": \"Appartement\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/residences/search",
              "host": ["{{base_url}}"],
              "path": ["api", "residences", "search"]
            }
          }
        },
        {
          "name": "Types d'appartements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/residences/types",
              "host": ["{{base_url}}"],
              "path": ["api", "residences", "types"]
            }
          }
        },
        {
          "name": "Villes disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/residences/villes",
              "host": ["{{base_url}}"],
              "path": ["api", "residences", "villes"]
            }
          }
        },
        {
          "name": "Quartiers d'une ville",
          "request": {
            "method": "GET",
            "header": [],
