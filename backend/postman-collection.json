                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statut\": \"confirmee\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/reservations/RES_1234567890_abc123def/status",
              "host": ["{{base_url}}"],
